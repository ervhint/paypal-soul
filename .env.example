# Names only. Real values go in .env.local (localhost), Vercel env vars and GitHub Actions secrets.
# Server only: none of these may get a NEXT_PUBLIC_ prefix.

# PayPal sandbox app `soul` (orders, captures)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal sandbox Platform app (consent and reading payments)
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
# PayPal account ID of the sandbox buyer behind the prepared data (it gave consent to the Platform app)
PAYPAL_PREPARED_ACCOUNT_ID=
# Sandbox email of Soul's test account that send money pays by default (the second sandbox personal account)
PAYPAL_SEND_RECIPIENT=

# OpenRouter (categories, story, chat)
OPENROUTER_API_KEY=

# Supabase Staging on localhost and Preview, Prod on Production
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Daily job (U11)
CRON_SECRET=
# Optional: the laptop IP, to open next dev from a phone on the same Wi-Fi
DEV_ORIGIN=
